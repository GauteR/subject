# Copy to .env in this directory (scripts/release.ps1 loads it) and fill in values.
# Never commit .env. Repo-root .env is also accepted.

# CurseForge Authors API token (https://authors.curseforge.com/#/settings/api-tokens)
CF_API_TOKEN=

# Wago Addons API token (https://addons.wago.io/account/apikeys)
WAGO_API_TOKEN=

# GitHub Releases are created by scripts/release.sh / .ps1 via `gh`
# (gh auth login). Do not set GH_API_TOKEN here — wrappers clear packager
# GitHub tokens to avoid duplicate releases.
